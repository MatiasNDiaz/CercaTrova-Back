# Base de datos (PostgreSQL)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# JWT
JWT_SECRET=
JWT_EXPIRATION_TIME=

# Admin por defecto (bootstrap)
# Se crea solo si NO existe ya un usuario con ese email.
# ⚠️ ADMIN_PASSWORD: mínimo 12 caracteres — con menos, la app ABORTA el arranque
#    (solo se valida cuando el admin todavía no existe, o sea en una base nueva).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=
ADMIN_PHONE=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── EMAIL ───────────────────────────────────────────────────────────────────
# Remitente de todos los emails (obligatoria: la app no arranca sin ella).
# Con SendGrid debe ser un remitente verificado; con SMTP, una casilla del dominio.
EMAIL_FROM=

# Transporte por DEFECTO: SendGrid.
# Es el más eficiente para envíos masivos — manda hasta 1000 destinatarios
# en una sola llamada HTTP (cada uno recibe su propio email).
SENDGRID_API_KEY=

# Transporte ALTERNATIVO: SMTP vía Nodemailer.
# Se activa automáticamente con solo definir SMTP_HOST; si está vacío se usa
# SendGrid. Sobre SMTP no existe el envío en lote: se entrega de a 5 en
# paralelo usando pool de conexiones.
#
# ⚠️ Con Gmail (smtp.gmail.com): el servidor REESCRIBE el header From a la
#    cuenta de SMTP_USER. Definir un EMAIL_FROM distinto NO cambia lo que ve
#    el destinatario, salvo que esa dirección esté verificada como alias en
#    "Enviar como" de la cuenta de SMTP_USER. Lo normal es que EMAIL_FROM y
#    SMTP_USER sean la MISMA dirección.
#    SMTP_PASS no es la contraseña de la cuenta: es una "app password" de 16
#    caracteres generada en la configuración de seguridad de Google.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 'true' fuerza TLS implícito. Con el puerto 465 se activa solo.
SMTP_SECURE=

# Google OAuth (obligatoria: la app no arranca sin ella)
GOOGLE_CLIENT_ID=

# Servidor
PORT=
# development | production
# ⚠️ En producción DEBE ser exactamente 'production': de esta variable dependen
#    (a) synchronize: false en TypeORM — sin esto el schema se auto-modifica y
#        puede dropear columnas con datos reales;
#    (b) el flag `secure` de la cookie de sesión — sin esto el JWT viaja por
#        HTTP plano.
NODE_ENV=

# CORS: origen(es) del frontend, separados por coma si hay varios.
# ⚠️ Sin esta variable el origin cae al fallback http://localhost:3001 y el
#    navegador bloquea TODAS las requests del frontend productivo.
FRONTEND_URL=
